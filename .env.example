NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Required for the admin panel. Use a unique password and a random secret of at least 32 characters.
ADMIN_EMAIL=admin@abenahairstudio.com
ADMIN_PASSWORD=replace-with-a-unique-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_NAME=Abena Hair Studio

# SMTP setup for booking/contact email notifications
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM="Abena Hair Studio <no-reply@yourdomain.com>"

# Optional: admin inbox for new message/booking alerts
ADMIN_NOTIFICATION_EMAIL=admin@yourdomain.com
